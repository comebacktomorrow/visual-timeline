# Copy to selfhost/.env (gitignored) and replace every value.
# Generate tokens and keys with:  openssl rand -hex 24

# Upload tokens, one per site, as one JSON map. A site groups sources (a
# house, an office, a venue); each uploader sends its site's token.
UPLOAD_TOKENS='{"home": "replace-with-a-random-token"}'

# The token Grafana uses to read frames. The Grafana service gets it from
# here too (it becomes the data source's token).
VIEWER_TOKEN=replace-with-a-random-token

# Signs image URLs, so images load in the browser without the viewer token.
IMG_SIGN_KEY=replace-with-a-random-key

# The address your browser uses to reach the backend. Image URLs are built
# on it. Change it to the machine's LAN name or address to view from other
# machines, e.g. http://nas.lan:8787
PUBLIC_URL=http://localhost:8787
