        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "vt-worker"
        },
        "query": {
          "queryType": "infinity",
          "refId": "site",
          "infinityQuery": {
            "refId": "site",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "http://backend:8787/sources",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "site",
                "text": "site",
                "type": "string"
              }
            ],
            "filters": []
          }
        },
        "multi": true,
        "includeAll": true,
        "allValue": "All",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      },
      {
        "name": "host",
