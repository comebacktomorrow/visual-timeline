{
  "uid": "visual-timeline",
  "title": "Visual Timeline",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "visual-timeline"
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "vt-worker"
        },
        "query": {
          "queryType": "infinity",
          "refId": "site",
          "infinityQuery": {
            "refId": "site",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "http://backend:8787/sources",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "site",
                "text": "site",
                "type": "string"
              }
            ],
            "filters": []
          }
        },
        "multi": true,
        "includeAll": true,
        "allValue": "All",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "vt-worker"
        },
        "query": {
          "queryType": "infinity",
          "refId": "host",
          "infinityQuery": {
            "refId": "host",
            "type": "json",
            "source": "url",
            "format": "table",
            "parser": "backend",
            "url": "http://backend:8787/sources?site=${site:csv}",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "id",
                "text": "id",
                "type": "string"
              }
            ],
            "filters": []
          }
        },
        "multi": true,
        "includeAll": true,
        "allValue": "All",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "savvycocoa1919-visualtimeline-panel",
      "title": "Timeline",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "timeline"
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "vt-worker"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://backend:8787/frames?site=${site:csv}&sources=${host:csv}&from=${__from}&to=${__to}&step=${__interval_ms}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "ts",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "site",
              "text": "site",
              "type": "string"
            },
            {
              "selector": "source",
              "text": "host",
              "type": "string"
            },
            {
              "selector": "url",
              "text": "image",
              "type": "string"
            },
            {
              "selector": "url_hi",
              "text": "image_hi",
              "type": "string"
            }
          ],
          "filters": [],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "vt-worker"
          }
        }
      ],
      "description": "Hover to scrub through the frames; drag across a strip to zoom in."
    },
    {
      "id": 2,
      "type": "savvycocoa1919-visualtimeline-panel",
      "title": "Multiview — follows the crosshair",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "mode": "grid",
        "followCrosshair": true
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "vt-worker"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://backend:8787/frames?site=${site:csv}&sources=${host:csv}&from=${__from}&to=${__to}&step=${__interval_ms}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "ts",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "site",
              "text": "site",
              "type": "string"
            },
            {
              "selector": "source",
              "text": "host",
              "type": "string"
            },
            {
              "selector": "url",
              "text": "image",
              "type": "string"
            },
            {
              "selector": "url_hi",
              "text": "image_hi",
              "type": "string"
            }
          ],
          "filters": [],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "vt-worker"
          }
        }
      ]
    }
  ],
  "description": "Frames from the self-hosted backend, read through Infinity: one query per panel asks the backend's /frames for every host of the selected sites."
}
