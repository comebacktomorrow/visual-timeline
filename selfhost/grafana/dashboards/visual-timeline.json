                      },
                      "screen-sleep:unexpected": {
                        "text": "SCREEN DARK (UNEXPECTED)",
                        "color": "orange",
                        "index": 5
                      },
                      "system-down": {
                        "text": "SYSTEM DOWN (PLANNED)",
                        "color": "purple",
                        "index": 6
                      },
                      "system-down:unexpected": {
                        "text": "SYSTEM DOWN (PLANNED)",
                        "color": "orange",
                        "index": 7
                      },
                      "app-stopped": {
                        "text": "APP STOPPED",
                        "color": "#2BA08C",
                        "index": 8
                      },
                      "app-stopped:unexpected": {
                        "text": "APP STOPPED",
                        "color": "orange",
                        "index": 9
                      },
                      "expired": {
                        "text": "NO DATA",
                        "index": 10
                      },
                      "expired:unexpected": {
                        "text": "NO DATA",
                        "color": "orange",
                        "index": 11
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^.+:unexpected$",
                      "result": {
                        "text": "PAUSED",
                        "color": "orange",
                        "index": 12
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^.+$",
                      "result": {
                        "text": "PAUSED",
                        "index": 13
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
