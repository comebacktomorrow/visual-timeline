{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Visual Timeline",
  "id": "savvycocoa1919-visualtimeline-app",
  "autoEnabled": true,
  "info": {
    "keywords": [
      "timeline",
      "screenshot",
      "camera",
      "kiosk",
      "multiview",
      "visual monitoring"
    ],
    "description": "Scrub-able visual timeline and multiview for image feeds — kiosk screens, security cameras, website thumbnails — with shared-crosshair sync, offline-gap semantics and a data source that keeps the API's viewer token server-side",
    "author": {
      "name": "Xzibit"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Repository",
        "url": "https://github.com/comebacktomorrow/visual-timeline"
      },
      {
        "name": "License",
        "url": "https://github.com/comebacktomorrow/visual-timeline/blob/main/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "Timeline and multiview on a dashboard",
        "path": "img/screenshot-dashboard.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "panel",
      "name": "Visual Timeline",
      "path": "panel/plugin.json"
    },
    {
      "type": "datasource",
      "name": "Visual Timeline API",
      "path": "datasource/plugin.json"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": []
  }
}
