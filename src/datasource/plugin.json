{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Visual Timeline API",
  "id": "savvycocoa1919-visualtimeline-datasource",
  "metrics": true,
  "info": {
    "keywords": ["timeline", "screenshot", "camera", "kiosk", "frames"],
    "description": "Connects Visual Timeline panels to a frames API, with site and host variables and ad hoc filters; the viewer token stays on Grafana's server",
    "author": {
      "name": "Xzibit"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://github.com/comebacktomorrow/visual-timeline#readme"
      },
      {
        "name": "Frames API",
        "url": "https://github.com/comebacktomorrow/visual-timeline/blob/main/docs/API.md"
      },
      {
        "name": "Repository",
        "url": "https://github.com/comebacktomorrow/visual-timeline"
      },
      {
        "name": "License",
        "url": "https://github.com/comebacktomorrow/visual-timeline/blob/main/LICENSE"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Visual Timeline",
      "path": "dashboards/visual-timeline.json"
    }
  ],
  "routes": [
    {
      "path": "api",
      "method": "GET",
      "url": "{{ .JsonData.apiUrl }}",
      "headers": [
        {
          "name": "Authorization",
          "content": "{{ if .SecureJsonData.viewerToken }}Bearer {{ .SecureJsonData.viewerToken }}{{ end }}"
        }
      ]
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
