{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Visual Timeline",
  "id": "savvycocoa1919-visualtimeline-datasource",
  "metrics": true,
  "info": {
    "keywords": ["timeline", "screenshot", "camera", "kiosk", "frames", "demo"],
    "description": "Frames from a web folder or public bucket of timestamped images, or demo data, for Visual Timeline panels, with site and host variables, ad hoc filters, and each host's last frame for Table and Canvas panels",
    "author": {
      "name": "Xzibit"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://github.com/comebacktomorrow/visual-timeline#readme"
      },
      {
        "name": "Repository",
        "url": "https://github.com/comebacktomorrow/visual-timeline"
      },
      {
        "name": "License",
        "url": "https://github.com/comebacktomorrow/visual-timeline/blob/main/LICENSE"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Visual Timeline",
      "path": "dashboards/visual-timeline.json"
    }
  ],
  "routes": [
    {
      "path": "folder",
      "method": "GET",
      "url": "{{ .JsonData.folderUrl }}",
      "headers": [
        {
          "name": "Authorization",
          "content": "{{ if .SecureJsonData.bearerToken }}Bearer {{ .SecureJsonData.bearerToken }}{{ end }}"
        }
      ]
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
