{
  "uid": "visual-timeline-starter",
  "title": "Visual Timeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "savvycocoa1919-visualtimeline-datasource",
        "current": {},
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "savvycocoa1919-visualtimeline-datasource",
          "uid": "${ds}"
        },
        "query": {
          "refId": "site",
          "type": "sites"
        },
        "definition": "sites",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "savvycocoa1919-visualtimeline-datasource",
          "uid": "${ds}"
        },
        "query": {
          "refId": "host",
          "type": "hosts",
          "sites": "${site:csv}"
        },
        "definition": "hosts in ${site:csv}",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1,
        "options": []
      },
      {
        "name": "filters",
        "label": "Filters",
        "type": "adhoc",
        "datasource": {
          "type": "savvycocoa1919-visualtimeline-datasource",
          "uid": "${ds}"
        },
        "filters": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "savvycocoa1919-visualtimeline-panel",
      "title": "Visual timeline",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {},
      "datasource": {
        "type": "savvycocoa1919-visualtimeline-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "savvycocoa1919-visualtimeline-datasource",
            "uid": "${ds}"
          },
          "sites": "${site:csv}",
          "hosts": "${host:csv}"
        }
      ],
      "description": "Hover to scrub through the frames; drag across a strip to zoom in."
    },
    {
      "id": 2,
      "type": "savvycocoa1919-visualtimeline-panel",
      "title": "Multiview — follows crosshair",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "mode": "grid",
        "followCrosshair": true
      },
      "datasource": {
        "type": "savvycocoa1919-visualtimeline-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "savvycocoa1919-visualtimeline-datasource",
            "uid": "${ds}"
          },
          "sites": "${site:csv}",
          "hosts": "${host:csv}"
        }
      ]
    },
    {
      "id": 3,
      "type": "savvycocoa1919-visualtimeline-panel",
      "title": "Multiview — latest only",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "mode": "grid",
        "followCrosshair": false,
        "imageFit": "fill"
      },
      "datasource": {
        "type": "savvycocoa1919-visualtimeline-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "savvycocoa1919-visualtimeline-datasource",
            "uid": "${ds}"
          },
          "sites": "${site:csv}",
          "hosts": "${host:csv}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Timeline and multiview grids for every source, with Site and Host dropdowns and a filter bar. Click a host, site or tag in a header to filter by it.",
  "tags": [
    "visual-timeline"
  ],
  "version": 1
}
